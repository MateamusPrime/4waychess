{
  "name": "4waychess",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "4waychess",
      "workspaces": [
        "packages/*",
        "apps/*"
      ],
      "engines": {
        "node": ">=24"
      }
    },
    "node_modules/@4wc/engine": {
      "resolved": "packages/engine",
      "link": true
    },
    "node_modules/@4wc/ui-core": {
      "resolved": "packages/ui-core",
      "link": true
    },
    "packages/engine": {
      "name": "@4wc/engine",
      "version": "0.1.0"
    },
    "packages/ui-core": {
      "name": "@4wc/ui-core",
      "version": "0.1.0",
      "dependencies": {
        "@4wc/engine": "*"
      }
    }
  }
}
