{
  "name": "4waychess",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run dev -w @4wc/web",
    "test": "npm run test --workspaces --if-present",
    "test:engine": "npm run test -w @4wc/engine",
    "perft": "npm run perft -w @4wc/engine",
    "advisor": "node packages/advisor/src/tools/advisor-cli.ts",
    "test:advisor": "npm run test -w @4wc/advisor",
    "trainer": "npm run dev -w @4wc/trainer"
  }
}
